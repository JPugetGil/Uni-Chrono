# Copier en .env (ignoré par git) et renseigner les clés.
# Elles sont intégrées au JavaScript publié : les restreindre à l'URL du site chez le fournisseur.

# Mapbox Isochrone API (marche, vélo, voiture) — obligatoire
VITE_MAPBOX_API_KEY=

# Geoapify Isoline API (transports en commun) — facultatif : sans clé, le mode n'est pas proposé.
# Offre gratuite : 3 000 crédits par jour, partagés par tous les visiteurs du site.
VITE_GEOAPIFY_API_KEY=
